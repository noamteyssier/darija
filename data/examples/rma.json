[{"t":"past","p":0,"lat":"rmit z-zbel f z-zenqa","ar":"رميت الزبل فالزنقة","en":"I threw the trash in the street."},{"t":"past","p":0,"neg":true,"lat":"ma rmitsh l-wraq dyali","ar":"ما رميتش الوراق ديالي","en":"I didn't throw away my papers."},{"t":"past","p":1,"lat":"rmiti l-kura b3id l-yum","ar":"رميتي الكورة بعيد اليوم","en":"You threw the ball far away today."},{"t":"past","p":1,"neg":true,"lat":"ma rmitish l-makla dyalna","ar":"ما رميتيش الماكلة ديالنا","en":"You didn't throw away our food."},{"t":"past","p":2,"lat":"rmiti s-sarut mn sh-sherjem","ar":"رميتي الساروت من الشرجم","en":"You (f.) threw the key out of the window."},{"t":"past","p":2,"neg":true,"lat":"ma rmitish l-kes l-mherres","ar":"ما رميتيش الكاس المهرس","en":"You (f.) didn't throw away the broken glass."},{"t":"past","p":3,"lat":"rma l-7jra f l-wad","ar":"رما الحجرة فالواد","en":"He threw the stone into the river."},{"t":"past","p":3,"neg":true,"lat":"ma rmash z-zbel f s-stel","ar":"ما رماش الزبل فالسطل","en":"He didn't throw the trash into the bucket."},{"t":"past","p":4,"lat":"rmat l-kura l khuha","ar":"رمات الكورة لخوها","en":"She threw the ball to her brother."},{"t":"past","p":4,"neg":true,"lat":"ma rmatsh l-7wayej dyalha","ar":"ما رماتش الحوايج ديالها","en":"She didn't throw away her clothes."},{"t":"past","p":5,"lat":"rmina sh-shebka f l-b7er","ar":"رمينا الشبكة فالبحر","en":"We threw the net into the sea."},{"t":"past","p":5,"neg":true,"lat":"ma rminash l-khobz l-yabes","ar":"ما رميناش الخبز اليابس","en":"We didn't throw away the dry bread."},{"t":"past","p":6,"lat":"rmitu l-kes f l-erd","ar":"رميتو الكاس فالأرض","en":"You (pl.) threw the glass on the ground."},{"t":"past","p":6,"neg":true,"lat":"ma rmitush l-kura l wladkum","ar":"ما رميتوش الكورة لولادكم","en":"You (pl.) didn't throw the ball to your children."},{"t":"past","p":7,"lat":"rmaw l-khshab f l-3afya","ar":"رماو الخشب فالعافية","en":"They threw the wood into the fire."},{"t":"past","p":7,"neg":true,"lat":"ma rmawsh l-karton f z-zenqa","ar":"ما رماوش الكارطون فالزنقة","en":"They didn't throw the cardboard in the street."},{"t":"pres","p":0,"lat":"kanrmi z-zbel kul sba7","ar":"كنرمي الزبل كل صباح","en":"I throw out the trash every morning."},{"t":"pres","p":0,"neg":true,"lat":"ma kanrmish l-makla f l-erd","ar":"ما كنرميش الماكلة فالأرض","en":"I don't throw food on the ground."},{"t":"pres","p":1,"lat":"katrmi l-kura l sa7bek","ar":"كترمي الكورة لصاحبك","en":"You throw the ball to your friend."},{"t":"pres","p":1,"neg":true,"lat":"ma katrmish l-wraq f l-bit","ar":"ما كترميش الوراق فالبيت","en":"You don't throw papers in the room."},{"t":"pres","p":2,"lat":"katrmi l-ma f j-jnan","ar":"كترمي الما فالجنان","en":"You (f.) throw water in the garden."},{"t":"pres","p":2,"neg":true,"lat":"ma katrmish l-khobz f z-zbel","ar":"ما كترميش الخبز فالزبل","en":"You (f.) don't throw bread in the trash."},{"t":"pres","p":3,"lat":"kayrmi s-snara f l-b7er","ar":"كيرمي الصنارة فالبحر","en":"He throws the fishing line into the sea."},{"t":"pres","p":3,"neg":true,"lat":"ma kayrmish l-kura b z-zerba","ar":"ما كيرميش الكورة بالزربة","en":"He doesn't throw the ball quickly."},{"t":"pres","p":4,"lat":"katrmi l-makla l l-qet","ar":"كترمي الماكلة للقط","en":"She throws food to the cat."},{"t":"pres","p":4,"neg":true,"lat":"ma katrmish l-keswa l-qdima","ar":"ما كترميش الكسوة القديمة","en":"She doesn't throw away the old dress."},{"t":"pres","p":5,"lat":"kanrmiw l-kura kul 3shiya","ar":"كنرميو الكورة كل عشية","en":"We throw the ball every afternoon."},{"t":"pres","p":5,"neg":true,"lat":"ma kanrmiwsh l-qra3i f l-b7er","ar":"ما كنرميوش القراعي فالبحر","en":"We don't throw bottles into the sea."},{"t":"pres","p":6,"lat":"katrmiw l-ma mn sh-sherjem","ar":"كترميو الما من الشرجم","en":"You (pl.) throw water out of the window."},{"t":"pres","p":6,"neg":true,"lat":"ma katrmiwsh z-zbel hna abadan","ar":"ما كترميوش الزبل هنا أبدا","en":"You (pl.) never throw trash here."},{"t":"pres","p":7,"lat":"kayrmiw l-7jar f l-wad","ar":"كيرميو الحجار فالواد","en":"They throw stones into the river."},{"t":"pres","p":7,"neg":true,"lat":"ma kayrmiwsh l-wraq f sh-shari3","ar":"ما كيرميوش الوراق فالشارع","en":"They don't throw papers in the street."},{"t":"fut","p":0,"lat":"ghadi nrmi had s-sbbat l-qdim","ar":"غادي نرمي هاد الصباط القديم","en":"I am going to throw away these old shoes."},{"t":"fut","p":0,"neg":true,"lat":"ma ghadish nrmi l-ktub dyali","ar":"ما غاديش نرمي الكتب ديالي","en":"I am not going to throw away my books."},{"t":"fut","p":1,"lat":"ghadi trmi l-kura daba","ar":"غادي ترمي الكورة دابا","en":"You are going to throw the ball now."},{"t":"fut","p":1,"neg":true,"lat":"ma ghadish trmi had l-kes","ar":"ما غاديش ترمي هاد الكاس","en":"You are not going to throw this glass."},{"t":"fut","p":2,"lat":"ghadi trmi s-sarut mn s-ste7","ar":"غادي ترمي الساروت من السطح","en":"You (f.) are going to throw the key from the roof."},{"t":"fut","p":2,"neg":true,"lat":"ma ghadish trmi had z-zerbiya","ar":"ما غاديش ترمي هاد الزربية","en":"You (f.) are not going to throw away this rug."},{"t":"fut","p":3,"lat":"ghadi yrmi z-zbel f l-bermil","ar":"غادي يرمي الزبل فالبرميل","en":"He is going to throw the trash into the bin."},{"t":"fut","p":3,"neg":true,"lat":"ma ghadish yrmi l-kura lina","ar":"ما غاديش يرمي الكورة لينا","en":"He is not going to throw the ball to us."},{"t":"fut","p":4,"lat":"ghadi trmi l-khobz l l-3safer","ar":"غادي ترمي الخبز للعصافر","en":"She is going to throw bread to the birds."},{"t":"fut","p":4,"neg":true,"lat":"ma ghadish trmi had l-werqa","ar":"ما غاديش ترمي هاد الورقة","en":"She is not going to throw away this paper."},{"t":"fut","p":5,"lat":"ghadi nrmiw had l-krasi l-mherrsin","ar":"غادي نرميو هاد الكراسي المهرسين","en":"We are going to throw away these broken chairs."},{"t":"fut","p":5,"neg":true,"lat":"ma ghadish nrmiw l-makla l-yum","ar":"ما غاديش نرميو الماكلة اليوم","en":"We are not going to throw away the food today."},{"t":"fut","p":6,"lat":"ghadi trmiw l-kura b3id bzzaf","ar":"غادي ترميو الكورة بعيد بزاف","en":"You (pl.) are going to throw the ball very far."},{"t":"fut","p":6,"neg":true,"lat":"ma ghadish trmiw z-zbel f j-jnan","ar":"ما غاديش ترميو الزبل فالجنان","en":"You (pl.) are not going to throw trash in the garden."},{"t":"fut","p":7,"lat":"ghadi yrmiw sh-shebka f l-ma","ar":"غادي يرميو الشبكة فالما","en":"They are going to throw the net into the water."},{"t":"fut","p":7,"neg":true,"lat":"ma ghadish yrmiw had l-kartuna","ar":"ما غاديش يرميو هاد الكارطونة","en":"They are not going to throw away this cardboard box."}]
