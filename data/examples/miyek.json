[{"t":"past","p":2,"lat":"miyekti 3la sa7btek f l-mdrasa","ar":"ميكتي على صاحبتك فالمدرسة","en":"You ignored your friend at school."},{"t":"pres","p":5,"lat":"7na kanmiyku 3la dak l-wa7ed dima","ar":"حنا كنميكو على داك الواحد ديما","en":"We always ignore that guy."},{"t":"fut","p":7,"lat":"ghadi ymiyku 3la dak l-mudir","ar":"غادي يميكو على داك المدير","en":"They're going to ignore that director."}]
