[{"t":"past","p":1,"lat":"la7edti shi 7aja jdida f d-dar","ar":"لاحضتي شي حاجة جديدة فالدار","en":"Did you notice something new in the house?"},{"t":"pres","p":3,"lat":"kayla7ed kulshi f l-qism","ar":"كيلاحض كلشي فالقسم","en":"He notices everything in class."},{"t":"fut","p":7,"lat":"ghadi yla7du l-farq mnin yjiw","ar":"غادي يلاحضو الفرق منين يجيو","en":"They'll notice the difference when they come."}]
