[{"t":"past","p":7,"lat":"tekkaw 3la l-7it","ar":"تكاو على الحيط","en":"They leaned on the wall."},{"t":"pres","p":2,"lat":"nti kattekkay dima 3la had l-7it","ar":"نتي كتتكاي ديما على هاد الحيط","en":"You always lean on this wall."},{"t":"fut","p":6,"lat":"ghadi ttekkaw 3la l-bab","ar":"غادي تتكاو على الباب","en":"You are going to lean on the door."}]
