[{"t":"past","p":0,"lat":"7reqt l-khobz f l-ferran","ar":"حرقت الخبز فالفران","en":"I burned the bread in the oven."},{"t":"past","p":0,"neg":true,"lat":"ma 7reqtsh l-wraq dyali","ar":"ما حرقتش الورق ديالي","en":"I didn't burn my papers."},{"t":"past","p":1,"lat":"wash 7reqti l-qmija dyali","ar":"واش حرقتي القميجة ديالي","en":"Did you burn my shirt?"},{"t":"past","p":1,"neg":true,"lat":"nta ma 7reqtish d-djaj l-bare7","ar":"نتا ما حرقتيش الدجاج البارح","en":"You didn't burn the chicken yesterday."},{"t":"past","p":2,"lat":"nti 7reqti l-3eshb f l-7diqa","ar":"نتي حرقتي العشب فالحديقة","en":"You (f.) burned the grass in the garden."},{"t":"past","p":2,"neg":true,"lat":"ma 7reqtish l-kaghet dyalek","ar":"ما حرقتيش الكاغط ديالك","en":"You (f.) didn't burn your paper."},{"t":"past","p":3,"lat":"7req l-3sha dyalna","ar":"حرق العشا ديالنا","en":"He burned our dinner."},{"t":"past","p":3,"neg":true,"lat":"huwa ma 7reqsh yedu","ar":"هو ما حرقش يدو","en":"He didn't burn his hand."},{"t":"past","p":4,"lat":"7erqat l-batata f z-zit","ar":"حرقات البطاطا فالزيت","en":"She burned the potatoes in the oil."},{"t":"past","p":4,"neg":true,"lat":"ma 7erqatsh l-khodra","ar":"ما حرقاتش الخضرة","en":"She didn't burn the vegetables."},{"t":"past","p":5,"lat":"7reqna l-kwaghet l-qdam","ar":"حرقنا الكواغط القدام","en":"We burned the old papers."},{"t":"past","p":5,"neg":true,"lat":"ma 7reqnash d-dar dyalkum","ar":"ما حرقناش الدار ديالكم","en":"We didn't burn your house."},{"t":"past","p":6,"lat":"7reqtu s-sardin kamlin","ar":"حرقتو السردين كاملين","en":"You (pl.) burned all the sardines."},{"t":"past","p":6,"neg":true,"lat":"ma 7reqtush l-lham dyalkum","ar":"ما حرقتوش اللحم ديالكم","en":"You (pl.) didn't burn your meat."},{"t":"past","p":7,"lat":"7erqu l-7atab f l-kanun","ar":"حرقو الحطب فالكانون","en":"They burned the wood in the brazier."},{"t":"past","p":7,"neg":true,"lat":"ma 7erqush l-7anut dyalhum","ar":"ما حرقوش الحانوت ديالهم","en":"They didn't burn their shop."},{"t":"pres","p":0,"l