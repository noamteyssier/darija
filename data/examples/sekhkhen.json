[{"t":"past","p":0,"lat":"sekhkhent l-makla f l-kuzina","ar":"سخنت الماكلة فالكوزينة","en":"I heated the food in the kitchen."},{"t":"past","p":0,"neg":true,"lat":"ma sekhkhentsh l-makla l-bare7","ar":"ما سخنتش الماكلة البارح","en":"I didn't heat the food yesterday."},{"t":"past","p":1,"lat":"sekhkhenti l-ma dyal d-dush","ar":"سخنتي الما ديال الدوش","en":"You heated the water for the shower."},{"t":"past","p":1,"neg":true,"lat":"ma sekhkhentish l-khobz f l-ferran","ar":"ما سخنتيش الخبز فالفران","en":"You didn't warm the bread in the oven."},{"t":"past","p":2,"lat":"sekhkhenti l-7lib l l-weld","ar":"سخنتي الحليب للولد","en":"You (f.) heated the milk for the boy."},{"t":"past","p":2,"neg":true,"lat":"ma sekhkhentish atay l d-dyaf","ar":"ما سخنتيش اتاي للضياف","en":"You (f.) didn't heat tea for the guests."},{"t":"past","p":3,"lat":"sekhkhen l-ghda dyalu b z-zerba","ar":"سخن الغدا ديالو بالزربة","en":"He heated his lunch quickly."},{"t":"past","p":3,"neg":true,"lat":"ma sekhkhensh l-ma dyal atay","ar":"ما سخنش الما ديال اتاي","en":"He didn't heat the water for tea."},{"t":"past","p":4,"lat":"sekhkhnat l-7rira f l-lil","ar":"سخنات الحريرة فالليل","en":"She heated the harira at night."},{"t":"past","p":4,"neg":true,"lat":"ma sekhkhnatsh l-3sha dyalna","ar":"ما سخناتش العشا ديالنا","en":"She didn't heat our dinner."},{"t":"past","p":5,"lat":"sekhkhenna l-khobz f l-meqla","ar":"سخنا الخبز فالمقلا","en":"We heated the bread in the pan."},{"t":"past","p":5,"neg":true,"lat":"ma sekhkhennash l-makla l-yum","ar":"ما سخناش الماكلة اليوم","en":"We didn't heat the food today."},{"t":"past","p":6,"lat":"sekhkhentu l-ma mzyan","ar":"سخنتو الما مزيان","en":"You (pl.) heated the water well."},{"t":"past","p":6,"neg":true,"lat":"ma sekhkhentush l-ghda f l-weqt","ar":"ما سخنتوش الغدا فالوقت","en":"You (pl.) didn't heat the lunch on time."},{"t":"past","p":7,"lat":"sekhkhnu l-makla f l-kuzina","ar":"سخنو الماكلة فالكوزينة","en":"They heated the food in the kitchen."},{"t":"past","p":7,"n