[{"t":"past","p":7,"lat":"tekhl3u mnin sme3u l-ra3d","ar":"تخلعو منين سمعو الرعد","en":"They got startled when they heard the thunder."},{"t":"pres","p":3,"lat":"huwa kaytekhle3 mn kul 7aja","ar":"هو كيتخلع من كل حاجة","en":"He gets startled by everything."},{"t":"fut","p":2,"lat":"ghadi ttekhl3i mnin tshufi l-film","ar":"غادي تتخلعي منين تشوفي الفيلم","en":"You (f.) are going to be startled when you watch the movie."}]
