[{"t":"past","p":3,"lat":"twa l-hdum dyalu f d-dulab","ar":"طوا الهدوم ديالو فالدولاب","en":"He folded his clothes in the closet."},{"t":"pres","p":1,"lat":"kattwi l-hdum dyalek kul nhar","ar":"كتطوي الهدوم ديالك كل نهار","en":"You fold your clothes every day."},{"t":"fut","p":7,"lat":"ghadi ytwiw l-hdum dyalhum daba","ar":"غادي يطويو الهدوم ديالهم دابا","en":"They are going to fold their clothes now."}]
