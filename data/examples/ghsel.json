[{"t":"past","p":1,"lat":"ghselti ydik qbel l-makla","ar":"غسلتي يديك قبل الماكلة","en":"You washed your hands before the meal."},{"t":"pres","p":7,"lat":"kaygheslu t-tumubil kul sbt","ar":"كيغسلو الطوموبيل كل سبت","en":"They wash the car every Saturday."},{"t":"fut","p":2,"lat":"ghadi tghesli l-7wayej dyalek ghedda","ar":"غادي تغسلي الحوايج ديالك غدا","en":"You will wash your clothes tomorrow."}]
