[{"t":"past","p":0,"lat":"khrejt b z-zerba mn l-khedma","ar":"خرجت بالزربة من الخدمة","en":"I left quickly from work."},{"t":"past","p":0,"neg":true,"lat":"ma khrejtsh mn d-dar l-bare7","ar":"ما خرجتش من الدار البارح","en":"I did not go out of the house yesterday."},{"t":"past","p":1,"lat":"wash khrejti m3a s-sba7 bekri","ar":"واش خرجتي مع الصباح بكري","en":"Did you go out early in the morning?"},{"t":"past","p":1,"neg":true,"lat":"nta ma khrejtish m3ana l-berra","ar":"نتا ما خرجتيش معانا لبرا","en":"You didn't go out outside with us."},{"t":"past","p":2,"lat":"nti khrejti mn l-biro daba","ar":"نتي خرجتي من البيرو دابا","en":"You left the office just now."},{"t":"past","p":2,"neg":true,"lat":"nti ma khrejtish l s-suq l-yum","ar":"نتي ما خرجتيش للسوق اليوم","en":"You didn't go out to the market today."},{"t":"past","p":3,"lat":"khrej khuya mn l-mdersa","ar":"خرج خويا من المدرسة","en":"My brother left school."},{"t":"past","p":3,"neg":true,"lat":"huwa ma khrejsh mn l-bit dyalu","ar":"هو ما خرجش من البيت ديالو","en":"He did not exit from his room."},{"t":"past","p":4,"lat":"kherjat khti m3a sa7ebtha","ar":"خرجات ختي مع صاحبتها","en":"My sister went out with her friend."},{"t":"past","p":4,"neg":true,"lat":"hiya ma kherjatsh l-lila","ar":"هي ما خرجاتش الليلة","en":"She did not go out tonight."},{"t":"past","p":5,"lat":"khrejna f l-weqt nishan","ar":"خرجنا فالوقت نيشان","en":"We left right on time."},{"t":"past","p":5,"neg":true,"lat":"ma khrejnash 7it kayn l-berd","ar":"ما خرجناش حيت كاين البرد","en":"We didn't go out because it is cold."},{"t":"past","p":6,"lat":"wash ntuma khrejtu mn s-sinima","ar":"واش نتوما خرجتو من السينما","en":"Did you leave the cinema?"},{"t":"past","p":6,"neg":true,"lat":"ntuma ma khrejtush f l-3shiya","ar":"نتوما ما خرجتوش فالعشية","en":"You didn't go out in the afternoon."},{"t":"past","p":7,"lat":"huma kherju ytemeshaw shwiya","ar":"هما خرجو يتمشاو شوية","en":"They went out to walk a little."},{"t":"past","p":7,"neg":true,"lat":"d-drari ma kherjush l z-zenqa","ar":"الدراري ما خرجوش للزنقة","en":"The children did not go out into the street."},{"t":"pres","p":0,"lat":"kankhrej kul nhaar f s-seb3a","ar":"كنخرج كل نهار فالسبعة","en":"I go out every day at seven."},{"t":"pres","p":0,"neg":true,"lat":"ma kankhrejsh f l-lil bezzef","ar":"ما كنخرجش فالليل بزاف","en":"I don't go out at night much."},{"t":"pres","p":1,"lat":"katkhrej dima f had l-weqt","ar":"كتخرج ديما فهاد الوقت","en":"You always leave at this time."},{"t":"pres","p":1,"neg":true,"lat":"nta ma katkhrejsh melli kayn l-berd","ar":"نتا ما كتخرجش ملي كاين البرد","en":"You do not go out when it is cold."},{"t":"pres","p":2,"lat":"wash katkherji m3a l-3ayla","ar":"واش كتخرجي مع العايلة","en":"Do you go out with the family?"},{"t":"pres","p":2,"neg":true,"lat":"nti ma katkherjish bla s-sarut","ar":"نتي ما كتخرجيش بلا الساروت","en":"You don't go out without the key."},{"t":"pres","p":3,"lat":"baba kaykhrej l l-qehwa l-yum","ar":"بابا كيخرج للقهوة اليوم","en":"My father goes out to the cafe today."},{"t":"pres","p":3,"neg":true,"lat":"huwa ma kaykhrejsh mn d-dar","ar":"هو ما كيخرجش من الدار","en":"He does not leave the house."},{"t":"pres","p":4,"lat":"khti katkhrej bekri kul tnin","ar":"ختي كتخرج بكري كل تنين","en":"My sister leaves early every Monday."},{"t":"pres","p":4,"neg":true,"lat":"hiya ma katkhrejsh f sh-shems","ar":"هي ما كتخرجش فالشمس","en":"She does not go out in the sun."},{"t":"pres","p":5,"lat":"7na kankherju f l-wikend dima","ar":"حنا كنخرجو فالويكاند ديما","en":"We always go out on the weekend."},{"t":"pres","p":5,"neg":true,"lat":"7na ma kankherjush f had s-sehd","ar":"حنا ما كنخرجوش فهاد الصهد","en":"We do not go out in this heat."},{"t":"pres","p":6,"lat":"wash katkherju m3a s-s7ab dima","ar":"واش كتخرجو مع الصحاب ديما","en":"Do you go out with friends always?"},{"t":"pres","p":6,"neg":true,"lat":"ntuma ma katkherjush bla l-flus","ar":"نتوما ما كتخرجوش بلا الفلوس","en":"You do not go out without money."},{"t":"pres","p":7,"lat":"kaykherju l-kheddama f l-khemsa","ar":"كيخرجو الخدامة فالخمسة","en":"The workers leave at five."},{"t":"pres","p":7,"neg":true,"lat":"huma ma kaykherjush b l-lil","ar":"هما ما كيخرجوش بالليل","en":"They do not go out at night."},{"t":"fut","p":0,"lat":"ghadi nkhrej m3a sa7bi daba","ar":"غادي نخرج مع صاحبي دابا","en":"I am going to go out with my friend now."},{"t":"fut","p":0,"neg":true,"lat":"ma ghadish nkhrej 7etta l ghedda","ar":"ما غاديش نخرج حتى لغدا","en":"I am not going to go out until tomorrow."},{"t":"fut","p":1,"lat":"ghadi tkhrej m3ana l l-b7er","ar":"غادي تخرج معانا للبحر","en":"You are going to go out with us to the sea."},{"t":"fut","p":1,"neg":true,"lat":"nta ma ghadish tkhrej l-lila","ar":"نتا ما غاديش تخرج الليلة","en":"You are not going to go out tonight."},{"t":"fut","p":2,"lat":"wash ghadi tkherji m3a khtek","ar":"واش غادي تخرجي مع ختك","en":"Are you going to go out with your sister?"},{"t":"fut","p":2,"neg":true,"lat":"nti ma ghadish tkherji daba","ar":"نتي ما غاديش تخرجي دابا","en":"You are not going to go out now."},{"t":"fut","p":3,"lat":"huwa ghadi ykhrej mn l-otil","ar":"هو غادي يخرج من الأوطيل","en":"He is going to check out of the hotel."},{"t":"fut","p":3,"neg":true,"lat":"huwa ma ghadish ykhrej l-yum","ar":"هو ما غاديش يخرج اليوم","en":"He is not going to go out today."},{"t":"fut","p":4,"lat":"mmi ghadi tkhrej l s-suq","ar":"مي غادي تخرج للسوق","en":"My mother is going to go out to the market."},{"t":"fut","p":4,"neg":true,"lat":"hiya ma ghadish tkhrej f sh-shta","ar":"هي ما غاديش تخرج فالشتا","en":"She is not going to go out in the rain."},{"t":"fut","p":5,"lat":"ghadi nkherju njibu l-khobz","ar":"غادي نخرجو نجيبو الخبز","en":"We are going to go out to bring bread."},{"t":"fut","p":5,"neg":true,"lat":"7na ma ghadish nkherju m3ahum","ar":"حنا ما غاديش نخرجو معاهم","en":"We are not going to go out with them."},{"t":"fut","p":6,"lat":"wash ntuma ghadi tkherju ghedda","ar":"واش نتوما غادي تخرجو غدا","en":"Are you going to go out tomorrow?"},{"t":"fut","p":6,"neg":true,"lat":"ntuma ma ghadish tkherju bekri","ar":"نتوما ما غاديش تخرجو بكري","en":"You are not going to go out early."},{"t":"fut","p":7,"lat":"huma ghadi ykherju mn l-khedma","ar":"هما غادي يخرجو من الخدمة","en":"They are going to leave work."},{"t":"fut","p":7,"neg":true,"lat":"d-drari ma ghadish ykherju l-yum","ar":"الدراري ما غاديش يخرجو اليوم","en":"The children are not going to go out today."}]
