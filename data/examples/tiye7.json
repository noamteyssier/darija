[{"t":"past","p":0,"lat":"tiye7t l-kas f l-kuzina","ar":"طيحت الكاس فالكوزينة","en":"I dropped the glass in the kitchen."},{"t":"past","p":0,"neg":true,"lat":"ma tiye7tsh s-swaret dyalek","ar":"ما طيحتش السوارت ديالك","en":"I didn't drop your keys."},{"t":"past","p":1,"lat":"tiye7ti t-tilifun dyalek f l-erd","ar":"طيحتي التليفون ديالك فالارض","en":"You dropped your phone on the floor."},{"t":"past","p":1,"neg":true,"lat":"ma tiye7tish l-ktab mn t-tebla","ar":"ما طيحتيش الكتاب من الطبلة","en":"You didn't drop the book from the table."},{"t":"past","p":2,"lat":"tiye7ti l-kora f l-ma","ar":"طيحتي الكورة فالما","en":"You (f.) dropped the ball in the water."},{"t":"past","p":2,"neg":true,"lat":"ma tiye7tish l-kebbut dyalek","ar":"ما طيحتيش الكبوط ديالك","en":"You (f.) didn't drop your jacket."},{"t":"past","p":3,"lat":"huwa tiye7 s-sberdila dyalu","ar":"هو طيح السبرديلة ديالو","en":"He dropped his sneaker."},{"t":"past","p":3,"neg":true,"lat":"ma tiye7sh l-flus f z-zenqa","ar":"ما طيحش الفلوس فالزنقة","en":"He didn't drop the money in the street."},{"t":"past","p":4,"lat":"tiy7at l-kisan dyal atay","ar":"طيحات الكيسان ديال اتاي","en":"She dropped the tea glasses."},{"t":"past","p":4,"neg":true,"lat":"ma tiy7atsh l-beztam dyalha","ar":"ما طيحاتش البزطام ديالها","en":"She didn't drop her wallet."},{"t":"past","p":5,"lat":"tiye7na t-tebsil b l-ghelat","ar":"طيحنا التبصيل بالغلط","en":"We dropped the plate by mistake."},{"t":"past","p":5,"neg":true,"lat":"ma tiye7nash had s-senduq","ar":"ما طيحناش هاد الصندوق","en":"We didn't drop this box."},{"t":"past","p":6,"lat":"tiye7tu l-werqa f l-erd","ar":"طيحتو الورقة فالارض","en":"You dropped the paper on the floor."},{"t":"past","p":6,"neg":true,"lat":"ma tiye7tush l-qer3a dyal l-ma","ar":"ما طيحتوش القرعة ديال الما","en":"You didn't drop the water bottle."},{"t":"past","p":7,"lat":"tiy7u l-krasa f l-bit","ar":"طيحو الكراسى فالبيت","en":"They knocked over the chairs in the room."},{"t":"past","p":7,"neg":true,"lat":"ma tiy7ush l-khobz f l-erd","ar":"ما طيحوش الخبز فالارض","en":"They didn't drop the bread on the floor."},{"t":"pres","p":0,"lat":"dima kantiye7 l-qlam dyali","ar":"ديما كنطيح القلم ديالي","en":"I always drop my pen."},{"t":"pres","p":0,"neg":true,"lat":"ma kantiye7sh l-makla f l-erd","ar":"ما كنطيحش الماكلة فالارض","en":"I don't drop food on the floor."},{"t":"pres","p":1,"lat":"dima kattiye7 s-swaret dyalek","ar":"ديما كتطيح السوارت ديالك","en":"You always drop your keys."},{"t":"pres","p":1,"neg":true,"lat":"ma kattiye7sh l-werqa mn yeddik","ar":"ما كتطيحش الورقة من يديك","en":"You don't drop the paper from your hands."},{"t":"pres","p":2,"lat":"3lash kattiy7i t-tilifun dima","ar":"علاش كتطيحي التليفون ديما","en":"Why do you (f.) always drop the phone?"},{"t":"pres","p":2,"neg":true,"lat":"ma kattiy7ish l-kisan b l-qesd","ar":"ما كتطيحيش الكيسان بالقصد","en":"You (f.) don't drop the glasses on purpose."},{"t":"pres","p":3,"lat":"kaytiye7 l-kora f l-7ewsh","ar":"كيطيح الكورة فالحوش","en":"He drops the ball in the courtyard."},{"t":"pres","p":3,"neg":true,"lat":"ma kaytiye7sh l-ghta dyal t-tenjra","ar":"ما كيطيحش الغطا ديال الطنجرة","en":"He doesn't drop the pot lid."},{"t":"pres","p":4,"lat":"kattiye7 l-khodra mn l-qoffa","ar":"كتطيح الخضرة من القفة","en":"She drops the vegetables from the basket."},{"t":"pres","p":4,"neg":true,"lat":"ma kattiye7sh l-beztam dyalha f t-tobis","ar":"ما كتطيحش البزطام ديالها فالطوبيس","en":"She doesn't drop her wallet on the bus."},{"t":"pres","p":5,"lat":"kantiy7u l-fakya mn sh-shejra","ar":"كنطيحو الفاكية من الشجرة","en":"We knock down fruit from the tree."},{"t":"pres","p":5,"neg":true,"lat":"ma kantiy7ush l-7wayej f t-triq","ar":"ما كنطيحوش الحوايج فالطريق","en":"We don't drop things on the road."},{"t":"pres","p":6,"lat":"3lash kattiy7u l-mwa3en f l-kuzina","ar":"علاش كتطيحو المواعن فالكوزينة","en":"Why do you knock over dishes in the kitchen?"},{"t":"pres","p":6,"neg":true,"lat":"ma kattiy7ush t-tbasel dyalkum","ar":"ما كتطيحوش الطباصل ديالكم","en":"You don't drop your plates."},{"t":"pres","p":7,"lat":"kaytiy7u l-krasa f l-qism","ar":"كيطيحو الكراسى فالقسم","en":"They knock down the chairs in the classroom."},{"t":"pres","p":7,"neg":true,"lat":"ma kaytiy7ush l-flus mn l-jib","ar":"ما كيطيحوش الفلوس من الجيب","en":"They don't drop money from the pocket."},{"t":"fut","p":0,"lat":"daba ghadi ntiye7 had s-senduq","ar":"دابا غادي نطيح هاد الصندوق","en":"Now I am going to drop this box."},{"t":"fut","p":0,"neg":true,"lat":"ma ghadish ntiye7 l-kas dyalek","ar":"ما غاديش نطيح الكاس ديالك","en":"I am not going to drop your glass."},{"t":"fut","p":1,"lat":"ghadi ttiye7 t-tilifun mn yeddik","ar":"غادي تطيح التليفون من يديك","en":"You are going to drop the phone from your hands."},{"t":"fut","p":1,"neg":true,"lat":"ma ghadish ttiye7 l-beztam dyalek","ar":"ما غاديش تطيح البزطام ديالك","en":"You are not going to drop your wallet."},{"t":"fut","p":2,"lat":"ghadi ttiy7i l-werqa f l-ma","ar":"غادي تطيحي الورقة فالما","en":"You (f.) are going to drop the paper in the water."},{"t":"fut","p":2,"neg":true,"lat":"ma ghadish ttiy7i had l-qer3a","ar":"ما غاديش تطيحي هاد القرعة","en":"You (f.) are not going to drop this bottle."},{"t":"fut","p":3,"lat":"huwa ghadi ytiye7 had l-7ayt","ar":"هو غادي يطيح هاد الحيط","en":"He is going to knock down this wall."},{"t":"fut","p":3,"neg":true,"lat":"ma ghadish ytiye7 s-swaret dyalu","ar":"ما غاديش يطيح السوارت ديالو","en":"He is not going to drop his keys."},{"t":"fut","p":4,"lat":"hiya ghadi ttiye7 t-tebsil l-kbir","ar":"هي غادي تطيح التبصيل الكبير","en":"She is going to drop the big plate."},{"t":"fut","p":4,"neg":true,"lat":"ma ghadish ttiye7 l-kora hna","ar":"ما غاديش تطيح الكورة هنا","en":"She is not going to drop the ball here."},{"t":"fut","p":5,"lat":"ghadi ntiy7u sh-shejra l-qdima","ar":"غادي نطيحو الشجرة القديمة","en":"We are going to knock down the old tree."},{"t":"fut","p":5,"neg":true,"lat":"ma ghadish ntiy7u l-mwa3en dyalna","ar":"ما غاديش نطيحو المواعن ديالنا","en":"We are not going to drop our dishes."},{"t":"fut","p":6,"lat":"ntuma ghadi ttiy7u l-bab","ar":"نتوما غادي تطيحو الباب","en":"You are going to knock down the door."},{"t":"fut","p":6,"neg":true,"lat":"ma ghadish ttiy7u had s-sel3a","ar":"ما غاديش تطيحو هاد السلعة","en":"You are not going to drop this merchandise."},{"t":"fut","p":7,"lat":"huma ghadi ytiy7u t-taman l-yum","ar":"هما غادي يطيحو التمن اليوم","en":"They are going to lower the price today."},{"t":"fut","p":7,"neg":true,"lat":"ma ghadish ytiy7u l-krasa f l-erd","ar":"ما غاديش يطيحو الكراسى فالارض","en":"They are not going to knock down the chairs on the ground."}]
