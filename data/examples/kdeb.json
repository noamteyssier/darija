[{"t":"past","p":0,"lat":"kdebt 3la l-bulis l-bare7","ar":"كدبت على البوليس البارح","en":"I lied to the police yesterday."},{"t":"past","p":0,"neg":true,"lat":"ma kdebtsh 3lik f l-khdma","ar":"ما كدبتش عليك فالخدمة","en":"I didn't lie to you at work."},{"t":"past","p":1,"lat":"kdebti 3la l-walid dyalek","ar":"كدبتي على الواليد ديالك","en":"You lied to your father."},{"t":"past","p":1,"neg":true,"lat":"ma kdebtish 3la sh-shaf dyalek","ar":"ما كدبتيش على الشاف ديالك","en":"You didn't lie to your boss."},{"t":"past","p":2,"lat":"kdebti 3la khtek l-bare7","ar":"كدبتي على ختك البارح","en":"You lied to your sister yesterday."},{"t":"past","p":2,"neg":true,"lat":"ma kdebtish 3la l-walida dyalek","ar":"ما كدبتيش على الواليدة ديالك","en":"You didn't lie to your mother."},{"t":"past","p":3,"lat":"huwa kdeb 3la jarna","ar":"هو كدب على جارنا","en":"He lied to our neighbor."},{"t":"past","p":3,"neg":true,"lat":"ma kdebsh 3la sa7bu l-bare7","ar":"ما كدبش على صاحبو البارح","en":"He didn't lie to his friend yesterday."},{"t":"past","p":4,"lat":"kedbat 3la l-ustada dyalha","ar":"كدبات على الاستاذة ديالها","en":"She lied to her teacher."},{"t":"past","p":4,"neg":true,"lat":"ma kedbatsh 3la mmha","ar":"ما كدباتش على مها","en":"She didn't lie to her mother."},{"t":"past","p":5,"lat":"kdebna 3la t-tbib f s-sba7","ar":"كدبنا على الطبيب فالصباح","en":"We lied to the doctor in the morning."},{"t":"past","p":5,"neg":true,"lat":"ma kdebnash 3la l-jiran dyalna","ar":"ما كدبناش على الجيران ديالنا","en":"We didn't lie to our neighbors."},{"t":"past","p":6,"lat":"kdebtu 3la l-mudir l-bare7","ar":"كدبتو على المدير البارح","en":"You lied to the director yesterday."},{"t":"past","p":6,"neg":true,"lat":"ma kdebtush 3la l-qadi","ar":"ما كدبتوش على القاضي","en":"You didn't lie to the judge."},{"t":"past","p":7,"lat":"kedbu 3la kulshi f d-dar","ar":"كدبو على كلشي فالدار","en":"They lied to everyone at home."},{"t":"past","p":7,"neg":true,"lat":"ma kedbush 3la l-7aris dyal l-3imara","ar":"ما كدبوش على ا