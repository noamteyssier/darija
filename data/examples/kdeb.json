[{"t":"past","p":5,"lat":"kdebna 3la l-mu3alim","ar":"كدبنا على المعلم","en":"We lied to the teacher."},{"t":"pres","p":4,"lat":"katkdeb 3la sa7btha dima","ar":"كتكدب على صاحبتها ديما","en":"She always lies to her friend."},{"t":"fut","p":3,"lat":"ghadi ykdeb 3lina ghedda","ar":"غادي يكدب علينا غدا","en":"He is going to lie to us tomorrow."}]
