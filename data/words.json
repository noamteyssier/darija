{"id":"j-jaw","group":"weather","kind":"word","lat":"j-jaw","ar":"الجو","en":"the weather","ex":{"lat":"kifach j-jaw l-yum?","ar":"كيفاش الجو اليوم؟","en":"How is the weather today?"}},
{"id":"j-jaw-zwin","group":"weather","kind":"phrase","lat":"j-jaw zwin","ar":"الجو زوين","en":"nice weather","note":"Two patterns: j-jaw plus an adjective (j-jaw zwin, j-jaw bard), or kayn / kayna plus a noun: kayn with masculine nouns (kayn r-rih), kayna with feminine ones (kayna ch-chta).","ex":{"lat":"j-jaw zwin, bghit nmchi l l-ba7r","ar":"الجو زوين، بغيت نمشي للبحر","en":"The weather is nice, I want to go to the beach"}},
{"id":"j-jaw-khayb","group":"weather","kind":"phrase","lat":"j-jaw khayb","ar":"الجو خايب","en":"bad weather","ex":{"lat":"j-jaw khayb, ma ghadich nkhrej","ar":"الجو خايب، ما غاديش نخرج","en":"The weather is bad, I am not going out"}},
{"id":"j-jaw-bard","group":"weather","kind":"phrase","lat":"j-jaw bard","ar":"الجو بارد","en":"cold weather","ex":{"lat":"j-jaw bard f ch-chta","ar":"الجو بارد فالشتا","en":"The weather is cold in winter"}},
{"id":"j-jaw-skhun","group":"weather","kind":"phrase","lat":"j-jaw skhun","ar":"الجو سخون","en":"hot weather","ex":{"lat":"j-jaw skhun f s-sif","ar":"الجو سخون فالصيف","en":"The weather is hot in summer"}},
{"id":"kayn-l-bard","group":"weather","kind":"phrase","lat":"kayn l-bard","ar":"كاين البرد","en":"it's cold","note":"l-bard (البرد) is the cold itself; bard (بارد) is the adjective: j-jaw bard.","ex":{"lat":"kayn l-bard bezzaf had s-sba7","ar":"كاين البرد بزاف هاد الصباح","en":"It is very cold this morning"}},
{"id":"kayna-ch-chems","group":"weather","kind":"phrase","lat":"kayna ch-chems","ar":"كاينة الشمس","en":"it's sunny","ex":{"lat":"kayna ch-chems l-yum","ar":"كاينة الشمس اليوم","en":"It is sunny today"}},
{"id":"j-jaw-mghayem","group":"weather","kind":"phrase","lat":"j-jaw mghayem","ar":"الجو مغيم","en":"it's cloudy","ex":{"lat":"j-jaw mghayem w ghadi tji ch-chta","ar":"الجو مغيم وغادي تجي الشتا","en":"It is cloudy and it is going to rain"}},
{"id":"kayn-r-rih","group":"weather","kind":"phrase","lat":"kayn r-rih","ar":"كاين الريح","en":"it's windy","ex":{"lat":"kayn r-rih bezzaf l-yum","ar":"كاين الريح بزاف اليوم","en":"It is very windy today"}},
{"id":"kayna-ch-chta","group":"weather","kind":"phrase","lat":"kayna ch-chta","ar":"كاينة الشتا","en":"it's raining","note":"ch-chta is both the rain and the winter.","ex":{"lat":"kayna ch-chta, khud l-mdella","ar":"كاينة الشتا، خود المظلة","en":"It is raining, take the umbrella"}},
{"id":"kayn-t-talj","group":"weather","kind":"phrase","lat":"kayn t-talj","ar":"كاين التلج","en":"there's snow","ex":{"lat":"kayn t-talj f l-atlas","ar":"كاين التلج فالأطلس","en":"There is snow in the Atlas"}},
{"id":"kayn-r-r3d","group":"weather","kind":"phrase","lat":"kayn r-r3d","ar":"كاين الرعد","en":"there's thunder","ex":{"lat":"sme3t r-r3d l-bare7","ar":"سمعت الرعد البارح","en":"I heard the thunder yesterday"}},
{"id":"kayn-l-berq","group":"weather","kind":"phrase","lat":"kayn l-berq","ar":"كاين البرق","en":"there's lightning","ex":{"lat":"chft l-berq f s-sma","ar":"شفت البرق فالسما","en":"I saw lightning in the sky"}},
{"id":"kayna-3asifa","group":"weather","kind":"phrase","lat":"kayna 3asifa","ar":"كاينة عاصفة","en":"there's a storm","ex":{"lat":"kayna 3asifa, ma tkhrejch","ar":"كاينة عاصفة، ما تخرجش","en":"There is a storm, do not go out"}},
{"id":"kayn-s-sahd","group":"weather","kind":"phrase","lat":"kayn s-sahd","ar":"كاين السهد","en":"it's scorching","note":"A spell of very hot, dry weather.","ex":{"lat":"kayn s-sahd had s-semmana","ar":"كاين السهد هاد السيمانة","en":"It is scorching this week"}},
{"id":"kayna-d-dbaba","group":"weather","kind":"phrase","lat":"kayna d-dbaba","ar":"كاينة الضبابة","en":"it's foggy","ex":{"lat":"kayna d-dbaba f s-sba7","ar":"كاينة الضبابة فالصباح","en":"There is fog in the morning"}},
{"id":"l-7arara","group":"weather","kind":"word","lat":"l-7arara","ar":"الحرارة","en":"the heat","note":"Also the word for a fever or temperature.","ex":{"lat":"l-7arara tal3a bezzaf f s-sif","ar":"الحرارة طالعة بزاف فالصيف","en":"It gets very hot in summer"}},
{"id":"kayn-ch-chergui","group":"weather","kind":"phrase","lat":"kayn ch-chergui","ar":"كاين الشرقي","en":"the chergui is blowing","note":"The chergui is the hot, dry wind from the east.","ex":{"lat":"kayn ch-chergui l-yum, j-jaw skhun","ar":"كاين الشرقي اليوم، الجو سخون","en":"The chergui is blowing today, the weather is hot"}},
{"id":"kayna-r-rtuba","group":"weather","kind":"phrase","lat":"kayna r-rtuba","ar":"كاينة الرطوبة","en":"it's humid","ex":{"lat":"f Casa kayna r-rtuba bezzaf","ar":"فكازا كاينة الرطوبة بزاف","en":"In Casa there is a lot of humidity"}},
{"id":"s-sma-safya","group":"weather","kind":"phrase","lat":"s-sma safya","ar":"السما صافية","en":"clear sky","ex":{"lat":"s-sma safya l-yum","ar":"السما صافية اليوم","en":"The sky is clear today"}},
{"id":"kayna-chta-qwiya","group":"weather","kind":"phrase","lat":"kayna chta qwiya","ar":"كاينة شتا قوية","en":"there's heavy rain","ex":{"lat":"kayna chta qwiya f l-lil","ar":"كاينة شتا قوية فالليل","en":"There is heavy rain at night"}},
{"id":"kayna-chta-khfifa","group":"weather","kind":"phrase","lat":"kayna chta khfifa","ar":"كاينة شتا خفيفة","en":"there's light rain","ex":{"lat":"kayna chta khfifa f s-sba7","ar":"كاينة شتا خفيفة فالصباح","en":"There is light rain in the morning"}},
{"id":"kayna-s-skhana","group":"weather","kind":"phrase","lat":"kayna s-skhana","ar":"كاينة السخانة","en":"it's hot","note":"s-skhana is the heat; skhun is the adjective: j-jaw skhun.","ex":{"lat":"kayna s-skhana bezzaf had s-semmana","ar":"كاينة السخانة بزاف هاد السيمانة","en":"It is very hot this week"}},
{"id":"katchti","group":"weather","kind":"phrase","lat":"katchti","ar":"كتشتي","en":"it's raining","note":"The most common way to say it: the verb chta, yechti. Also d-denya katchti.","ex":{"lat":"katchti l-yum, khud l-mdella","ar":"كتشتي اليوم، خود المظلة","en":"It is raining today, take the umbrella"}}]}
