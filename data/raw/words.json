  {"group":"time","kind":"word","lat":"mazal","ar":"مازال","en":"still / not yet","note":"With a verb it means still (mazal kayakhdem, he is still working). With ma and a negative it means not yet."},
  {"group":"time","kind":"word","lat":"s-sbah","ar":"الصباح","en":"morning","note":"s-sbah on its own also means in the morning."},
  {"group":"time","kind":"word","lat":"z-zwal","ar":"الزوال","en":"noon / midday"},
  {"group":"time","kind":"word","lat":"l3shiya","ar":"العشية","en":"afternoon / evening","note":"The late afternoon into the evening, after about 4 pm."},
  {"group":"time","kind":"word","lat":"l-lil","ar":"الليل","en":"night","note":"l-lil is the night as a time of day; lila is one night (lila wa7da)."},
  {"group":"time","kind":"word","lat":"nuss l-lil","ar":"نص الليل","en":"midnight"},
  {"group":"time","kind":"phrase","lat":"imta?","ar":"إمتا؟","en":"when?","ex":{"lat":"imta ghadi tji?","ar":"إمتا غادي تجي؟","en":"When are you coming?"}},
  {"group":"time","kind":"phrase","lat":"kol nhar","ar":"كل نهار","en":"every day","note":"kol + a noun means every: kol semmana, kol shher, kol 3am."},

