{"_doc":"Hand-written source for scripts/build_words.py. Invariable words and set phrases (no gender, plural or possessive forms), in arabizi with the Arabic spelling. group: time (when), calendar (units, days, seasons, this/next/last), direction (left, right, compass, here/there, where). kind: word or phrase. None of these are from the Peace Corps book; the author wrote them, so they should be checked with a speaker.",
"words":[
  {"group":"time","kind":"word","lat":"lyum","ar":"ليوم","en":"today","ex":{"lat":"lyum ghadi nkhdem","ar":"ليوم غادي نخدم","en":"Today I am going to work"}},
  {"group":"time","kind":"word","lat":"lbare7","ar":"البارح","en":"yesterday","ex":{"lat":"lbare7 mshit l-suq","ar":"البارح مشيت للسوق","en":"Yesterday I went to the market"}},
  {"group":"time","kind":"word","lat":"ghedda","ar":"غدا","en":"tomorrow","ex":{"lat":"ghedda ghadi nshuf-ek","ar":"غدا غادي نشوفك","en":"Tomorrow I will see you"}},
  {"group":"time","kind":"word","lat":"b3d ghedda","ar":"بعد غدا","en":"the day after tomorrow"},
  {"group":"time","kind":"word","lat":"daba","ar":"دابا","en":"now","ex":{"lat":"daba kanakhdem","ar":"دابا كنخدم","en":"Now I am working"}},
  {"group":"time","kind":"word","lat":"dghya","ar":"دغيا","en":"quickly / right away","note":"Also used for soon: nji dghya, I will come soon."},
  {"group":"time","kind":"word","lat":"men b3d","ar":"من بعد","en":"later / afterwards","ex":{"lat":"nshufu men b3d","ar":"نشوفو من بعد","en":"We will see each other later"}},
  {"group":"time","kind":"word","lat":"dima","ar":"ديما","en":"always","ex":{"lat":"dima kaytsennak","ar":"ديما كايتسناك","en":"He always waits for you"}},
